{
  "manifest_version": 3,
  "name": "Task Dashboard Extension",
  "version": "1.0",
  "description": "React Task Dashboard as a Chrome Extension",
  "action": {
    "default_popup": "index.html"
  },
  "permissions": ["storage", "geolocation"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
